# Add a second CRLDP extension. Section 4.8.6 requires a SINGLE
# DistributionPoint with fullName only, no CRLIssuer, no Reasons.
# Having two extensions with the CRLDistributionPoints OID also
# violates RFC 5280 (each extension MUST appear at most once).

[node: ca.cer]
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, cdp, aia, sia, cp, ip, as, cdpx ]
