# Remove SIA from the CA cert's extension list.
# Section 4.8.8.1 requires SIA in CA certificates.
[node: ca.cer]
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, cdp, aia, cp, ip, as ]
