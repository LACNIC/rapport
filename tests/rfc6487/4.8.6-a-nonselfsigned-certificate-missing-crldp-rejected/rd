ta.cer
	ca.cer
		route.roa
		ca.mft
		ca.crl
	ta.mft
	ta.crl

[node: route.roa]
obj.content.encapContentInfo.eContent.ipAddrBlocks = [ 1.1.0.0/24 ]
obj.content.encapContentInfo.eContent.asId = 64512

# Remove CRLDP from the CA cert's extension list.
# Section 4.8.6 requires it in all non-self-signed certificates.
[node: ca.cer]
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, aia, sia, cp, ip, as ]
