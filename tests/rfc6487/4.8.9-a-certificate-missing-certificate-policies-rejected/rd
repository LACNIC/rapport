[node: route.roa]
obj.content.encapContentInfo.eContent.ipAddrBlocks = [ 1.1.0.0/24 ]
obj.content.encapContentInfo.eContent.asId = 64512

# Remove Certificate Policies from the CA cert's extension list.
# Section 4.8.9 requires it (critical) with exactly one policy.
[node: ca.cer]
obj.tbsCertificate.extensions = [ bc, ski, aki, ku, cdp, aia, sia, ip, as ]
